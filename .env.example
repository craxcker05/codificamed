# Copiar a .env y completar. NUNCA escribir claves reales en este archivo.

# Proveedor de LLM: ollama | gemini  (único punto de cambio)
LLM_PROVIDER=ollama

# Ollama (local, por defecto)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Gemini (externo, API gratuita de Google AI Studio)
# Solo enviar CodiEsp y notas ficticias: el tier gratuito puede usar los datos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings (la temperatura de los LLM es 0 fija en el código, no configurable)
EMBEDDING_MODEL=intfloat/multilingual-e5-base
